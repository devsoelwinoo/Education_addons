<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


        <!-- =================== Calendar view ================  -->
        <record id="view_education_student_calendar" model="ir.ui.view">
            <field name="name">education.student.calendar</field>
            <field name="model">education.student</field>
            <field name="arch" type="xml">
                <calendar string="Students Calendar" date_start="dob">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="age"/>
                </calendar>
            </field>
        </record>


        <!-- ====================== Kanban View ================== -->
        <record id="education_student_kanban_view" model="ir.ui.view">
            <field name="name">education.student.kanban</field>
            <field name="model">education.student</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <strong>
                                    <field name="name"/>
                                </strong>

                                <div>
                                    Code: <field name="code"/>
                                </div>

                                <div>
                                    Age: <field name="age"/>
                                </div>

                                <div>
                                    Phone: <field name="phone"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ==================== TREE VIEW ==================== -->
        <record id="view_education_student_tree" model="ir.ui.view">
            <field name="name">education.student.tree</field>
            <field name="model">education.student</field>
            <field name="arch" type="xml">
                <list string="Education Student" >
                    <field name="name"/>
                    <field name="code"/>
                    <field name="age"/>
                    <field name="parent_id"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="gender" widget="badge" options="{'male':'blue','female':'pink'}"/>
                    <field name="dob"/>
                    <field name="address"/>
                    <field name="batch_id"/>
                </list>
            </field>
        </record>

        <!-- ==================== FORM VIEW ==================== -->
        <record id="view_education_student_form" model="ir.ui.view">
            <field name="name">education.student.form</field>
            <field name="model">education.student</field>
            <field name="arch" type="xml">
                <form string="Education Student">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="age"/>
                                <field name="parent_id"/>
                                <field name="phone"/>
                            </group>
                            <group>
                                <field name="email"/>
                                <field name="gender"/>
                                <field name="dob"/>
                                <field name="address"/>
                                <field name="batch_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ==================== SEARCH VIEW ==================== -->
        <record id="view_education_student_search" model="ir.ui.view">
            <field name="name">education.student.search</field>
            <field name="model">education.student</field>
            <field name="arch" type="xml">
                <search string="Students">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="age"/>
                    <field name="parent_id"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="gender"/>
                    <field name="dob"/>
                    <field name="address"/>
                    <field name="batch_id"/>
                    <!-- <group expand="0" string="Group By">
                        <filter name="group_by_student" string="Student" context="{'group_by': 'student_id'}"/>
                    </group> -->
                </search>
            </field>
        </record>

        <!-- ==================== WINDOW ACTION ==================== -->
        <record id="action_education_student" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">education.student</field>
            <field name="view_mode">kanban,list,form,calendar</field>
            <field name="search_view_id" ref="view_education_student_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first Student.
                </p>
            </field>
        </record>

        <record id="action_student" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">education.student</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <record id="action_parent" model="ir.actions.act_window">
            <field name="name">Parent</field>
            <field name="res_model">education.parent</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <!-- ==================== MENU ITEMS ==================== -->

        <!-- Root menu (you can change parent to your education module menu if you have one) -->
        <menuitem id="menu_education"
                  name="Education"
                  sequence="10" web_icon="education,static/description/icon.png"/>

        <!-- Sub menu to open Student Log Notes -->
        <menuitem id="menu_education_student"
                  name="Students"
                  parent="menu_education"
                  action="action_education_student"
                  sequence="20"/>

        <!-- Header title -->
        <menuitem id="student_info_title"
                  name="Students info"
                  parent="menu_education_student"
                  action="action_education_student"
                  sequence="20"/>

        <menuitem id="parent_info_title"
                  name="Parent info"
                  parent="menu_education_student"
                  action="action_education_student"
                  sequence="20"/>

        <!-- Sub menu to open Student Log Notes -->
        <menuitem id="menu_student_list"
                 name="Student List"
                 parent="student_info_title"
                 action="action_student"
                 sequence="1"/>

        <menuitem id="menu_parent_list"
                 name="Gurdian"
                 parent="parent_info_title"
                 action="action_parent"
                 sequence="2"/>
    </data>
</odoo>