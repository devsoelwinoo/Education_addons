<odoo>
    <!-- Form view extension -->
    <record id="student_form_inherit" model="ir.ui.view">
        <field name="name">education.student.form.inherit</field>
        <field name="model">education.student</field>
        <field name="inherit_id" ref="education.view_education_student_form"></field>
        <field name="arch" type="xml">
        <xpath expr="//field[@name='age']" position="after">
            <field name="studentGpa"/>
        </xpath>
        </field>
    </record>

    <!-- Tree view extension -->
    <record id="student_tree_inherit" model="ir.ui.view">
        <field name="name">education.student.tree.inherit</field>
        <field name="model">education.student</field>
        <field name="inherit_id" ref="education.view_education_student_tree"/>
        <field name="arch" type="xml">
                <xpath expr="//field[@name='age']" position="after">
                <field name="studentGpa"/>
                </xpath>
        </field>
    </record>
</odoo>