<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ==================== TREE VIEW ==================== -->
        <record id="view_education_lecture_tree" model="ir.ui.view">
            <field name="name">education.lecture.tree</field>
            <field name="model">education.lecture</field>
            <field name="arch" type="xml">
                <list string="Education Student" >
                    <field name="title"/>
                    <field name="lectureCode"/>
                    <field name="startDate"/>
                    <field name="endDate"/>
                    <field name="duration"/>
                    <field name="location"/>
                    <field name="type"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- ==================== FORM VIEW ==================== -->
        <record id="view_education_lecture_form" model="ir.ui.view">
            <field name="name">education.lecture.form</field>
            <field name="model">education.lecture</field>
            <field name="arch" type="xml">
                <form string="Education Student">
                    <sheet>
                        <group>
                            <group>
                                <field name="title"/>
                                <field name="lectureCode"/>
                                <field name="startDate"/>
                                <field name="endDate"/>
                            </group>
                            <group>
                                <field name="duration"/>
                                <field name="location"/>
                                <field name="type"/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ==================== SEARCH VIEW ==================== -->
        <record id="view_education_lecture_search" model="ir.ui.view">
            <field name="name">education.lecture.search</field>
            <field name="model">education.lecture</field>
            <field name="arch" type="xml">
                <search string="Students">
                    <field name="title"/>
                    <field name="lectureCode"/>
                    <field name="startDate"/>
                    <field name="endDate"/>
                    <field name="duration"/>
                    <field name="location"/>
                    <field name="type"/>
                    <field name="description"/>
                    <!-- <group expand="0" string="Group By">
                        <filter name="group_by_student" string="Student" context="{'group_by': 'student_id'}"/>
                    </group> -->
                </search>
            </field>
        </record>

        <!-- ==================== WINDOW ACTION ==================== -->
        <record id="action_education_lecture" model="ir.actions.act_window">
            <field name="name">Lecture</field>
            <field name="res_model">education.lecture</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_education_lecture_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first Student.
                </p>
            </field>
        </record>

        <!-- ==================== MENU ITEMS ==================== -->

        <!-- Root menu (you can change parent to your education module menu if you have one) -->
        <menuitem id="menu_education"
                  name="Education"
                  sequence="10" web_icon="education,static/description/icon.png"/>
                  

        <!-- Sub menu to open Student Log Notes -->
        <menuitem id="menu_education_lecture"
                  name="Lecture"
                  parent="menu_education"
                  action="action_education_lecture"
                  sequence="21"/>


    </data>
</odoo>
