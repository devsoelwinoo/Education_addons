<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_education_parent_tree" model="ir.ui.view">
            <field name="name">education.parent.tree</field>
            <field name="model">education.parent</field>
            <field name="arch" type="xml">
                <list string="Batch Tree">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="address"/>
                    <field name="student_ids"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_education_parent_form" model="ir.ui.view">
            <field name="name">education.parent.form</field>
            <field name="model">education.parent</field>
            <field name="arch" type="xml">
                <form string="Batch Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="address"/>
                                <field name="student_ids">
                                    <list create="0" delete="0" edit="0">
                                        <field name="name"/>
                                        <field name="parent_id"/>
                                        <field name="age"/>
                                        <field name="phone"/>
                                        <field name="email"/>
                                    </list>
                                </field>
                                <field name="student_ids"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_education_parent_search" model="ir.ui.view">
            <field name="name">education.parent.search</field>
            <field name="model">education.parent</field>
            <field name="arch" type="xml">
                <search string="Batch Search">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="address"/>
                    <field name="student_ids"/>
                </search>
            </field>
        </record>

        <!-- window action -->
        <record id="action_education_parent" model="ir.actions.act_window">
            <field name="name">Batch</field>
            <field name="res_model">education.parent</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_education_parent_search"></field>
            <field name="help" type="html">
                <p class="o_view_noncontent_smiling_face">
                    Create the first batch
                </p>
            </field>
        </record>

        <!-- menu item -->
        <menuitem id="menu_education"
                  name="Education"
                  sequence="10" web_icon="education,static/description/icon.png"/>
                  

        <!-- Sub menu to open Student Log Notes -->
        <menuitem id="menu_education_parent"
                  name="Parent"
                  parent="menu_education"
                  action="action_education_parent"
                  sequence="25"/>

    </data>
</odoo>