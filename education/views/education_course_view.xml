<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_education_course_tree" model="ir.ui.view">
            <field name="name">education.course.tree</field>
            <field name="model">education.course</field>
            <field name="arch" type="xml">
                <list string="Education Student" >
                    <field name="courseName"/>
                    <field name="courseTeacher"/>
                    <field name="courseDuration"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_education_course_form" model="ir.ui.view">
            <field name="name">education.course.form</field>
            <field name="model">education.course</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="courseName"/>
                            <field name="courseTeacher"/>
                            <field name="courseDuration"/>
                        </group>

                        <notebook>

                        <!-- Subjects Tab -->
                            <page string="Subjects">
                                <field name="subject_ids">
                                    <list editable="bottom">
                                        <field name="subjName"/>
                                        <field name="learningHour"/>
                                        <field name="room"/>
                                    </list>
                                </field>
                            </page>

                        <!-- Students Tab -->
                            <page string="Students">
                                <field name="student_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="age"/>
                                        <field name="gender"/>
                                    </list>
                                </field>
                            </page>

                        </notebook>                       
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Search view -->
        <record id="view_education_course_search" model="ir.ui.view">
            <field name="name">education.course.search</field>
            <field name="model">education.course</field>
            <field name="arch" type="xml">
                <search>
                    <field name="courseName"/>
                    <field name="courseTeacher"/>
                    <field name="courseDuration"/>
                </search>
            </field>
        </record>

        <!-- window action -->
        <record id="action_education_course" model="ir.actions.act_window">
            <field name="name">Course</field>
            <field name="res_model">education.course</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_education_course_search"></field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                 Create the first course.
                </p>
            </field>
        </record>

        <!-- menu item -->
        <menuitem id="menu_education" 
                  name="education" 
                  sequence="10" web_icon="education,static/description/icon.png"/>
        <menuitem id="menu_education_course"
                  name="Course"
                  parent="menu_education"
                  sequence="24"
                  action="action_education_course"/>
    </data>
</odoo>
